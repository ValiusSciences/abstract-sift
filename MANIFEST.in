include README.md LICENSE .env.example
recursive-include docs *.md
recursive-include examples *.json *.jsonl *.txt
recursive-include scripts *.py
recursive-include tests *.py *.cjs
recursive-include src/abstract_sift/web *.html *.css *.js
prune data
prune exports
prune .venv
prune build
prune .git
global-exclude __pycache__ *.pyc .env *.sqlite *.sqlite-wal *.sqlite-shm *.db *.pem *.key
